# Supabase（从 Supabase 项目 Settings → API 复制）
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon公钥

# 站点地址（本地开发用 localhost，部署后改成 Vercel 域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 服务端专用密钥（阶段 2 转写流水线才用到，现在留空即可）
SUPABASE_SERVICE_ROLE_KEY=

# AI 服务密钥（阶段 2/3 才用到，现在留空即可）
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
